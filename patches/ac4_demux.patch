+/* Bounded metadata envelope only: v2.3/v2.4 revision 0, no transform flags;
+ * v2.4 footer is supported. Metadata payload is skipped, not interpreted. */
+static int ac4_id3_size(const uint8_t *h)
+{
+    int size = 0, i;
+    if ((h[3] != 3 && h[3] != 4) || h[4] ||
+        (h[5] & ~(h[3] == 4 ? 0x10 : 0)))
+        return AVERROR_INVALIDDATA;
+    for (i = 6; i < 10; i++) {
+        if (h[i] & 0x80)
+            return AVERROR_INVALIDDATA;
+        size = (size << 7) | h[i];
+    }
+    if (size > 1024 * 1024)
+        return AVERROR_INVALIDDATA;
+    return size;
+}
